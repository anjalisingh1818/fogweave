   ],
   "label": "UP-AGREES Project Launch"
  },
  {
   "@id": "urn:fogweave:node:n%3A7c531405de72%3Ac1",
   "@type": [
    "fw:Claim"
   ],
   "label": "UP-AGREES is a World Bank-supported project aimed at improving agricultural productivity and farmer incomes in Eastern Uttar Pradesh and Bundelkhand.",
   "url": "https://timesofindia.indiatimes.com/city/lucknow/up-agrees-a-new-roadmap-for-agricultural-prosperity-in-eastern-up-and-bundelkhand/articleshow/135066096.cms",
   "quote": "World Bank-supported Uttar Pradesh Agriculture Growth and Rural Enterprise Ecosystem Strengthening (UP-AGREES) Project",
   "verdict": "unverified",
   "independentDomains": 1,
   "supports": 1,
   "contradicts": 0
  },
  {
   "@id": "urn:fogweave:node:n%3A7c531405de72%3Ac2",
   "@type": [
    "fw:Claim"
   ],
   "label": "UP-AGREES will cover 123 development blocks in 28 districts, benefiting nearly 10 lakh farmers, 35,000 fish-producing farmers and around three lakh women.",
   "url": "https://timesofindia.indiatimes.com/city/lucknow/up-agrees-a-new-roadmap-for-agricultural-prosperity-in-eastern-up-and-bundelkhand/articleshow/135066096.cms",
   "quote": "project is being implemented across 123 development blocks in 28 districts, with the objective of benefiting nearly 10 lakh farmers",
   "verdict": "unverified",
   "independentDomains": 1,
   "supports": 1,
   "contradicts": 0
  },
  {
   "@id": "urn:fogweave:node:n%3A7c531405de72%3Ac3",
   "@type": [
    "fw:Claim"
   ],
   "label": "UP-AGREES aims to introduce Direct Seeded Rice (DSR) and climate-smart practices such as zero tillage and improved seeds.",
   "url": "https://timesofindia.indiatimes.com/city/lucknow/up-agrees-a-new-roadmap-for-agricultural-prosperity-in-eastern-up-and-bundelkhand/articleshow/135066096.cms",
   "quote": "Direct Seeded Rice, or DSR, is being experimented with across 3,000 hectares",
   "verdict": "unverified",
   "independentDomains": 1,
   "supports": 1,
   "contradicts": 0
  },
  {
   "@id": "urn:fogweave:node:n%3A7c531405de72%3Ac4",
   "@type": [
    "fw:Claim"
   ],
   "label": "The project plans a 1,500‑acre paddy cluster in Bahraich to improve income per acre by 20‑30% and reduce urea consumption by 25%.",
   "url": "https://timesofindia.indiatimes.com/city/lucknow/up-agrees-a-new-roadmap-for-agricultural-prosperity-in-eastern-up-and-bundelkhand/articleshow/135066096.cms",
   "quote": "development of a 1,500-acre paddy cluster in Bahraich",
   "verdict": "unverified",
   "independentDomains": 1,
   "supports": 0,
   "contradicts": 0
  },
